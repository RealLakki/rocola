# ─────────────────────────────────────────────────────────────────────────────
# La Cantina Plus — variables de entorno del SERVER (Express en el VPS).
# El frontend NO usa env vars: todas las API keys son server-only y los datos
# van por /api/*. Copia este archivo a `.env` y complétalo.
# ─────────────────────────────────────────────────────────────────────────────

# Puerto del server Express (Nginx hace reverse-proxy a este puerto).
PORT=3100

# ── PostgreSQL (autohospedado en el VPS, escucha solo en localhost) ──
PGHOST=localhost
PGPORT=5432
PGUSER=rockola
PGPASSWORD=changeme
PGDATABASE=rockola
# Alternativa a las piezas de arriba (tiene prioridad si está seteada):
# DATABASE_URL=postgres://rockola:changeme@localhost:5432/rockola

# ── API keys (SOLO server, nunca expuestas al cliente) ──
# YouTube Data API v3 — restringe la key por HTTP referrer en Google Cloud Console.
YOUTUBE_API_KEY=AIza...
# Last.fm API — tags de género (más granular que iTunes).
# Crear key en https://www.last.fm/api/account/create
LASTFM_API_KEY=
